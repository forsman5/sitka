[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/ui/main_menu.gd" id="1_main_menu"]

[sub_resource type="StyleBoxFlat" id="PanelStyle_1"]
bg_color = Color(0.08, 0.08, 0.1, 0.95)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.3, 0.3, 0.4, 0.8)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_left = 4
corner_radius_bottom_right = 4

[node name="MainMenu" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1_main_menu")

[node name="Background" type="ColorRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.08, 0.08, 0.12, 1)

[node name="Panel" type="Panel" parent="."]
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -170.0
offset_top = -235.0
offset_right = 170.0
offset_bottom = 235.0
theme_override_styles/panel = SubResource("PanelStyle_1")

[node name="VBox" type="VBoxContainer" parent="Panel"]
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 20.0
offset_top = 20.0
offset_right = -20.0
offset_bottom = -20.0
theme_override_constants/separation = 16

[node name="TitleLabel" type="Label" parent="Panel/VBox"]
text = "SITKA"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 32

[node name="StartButton" type="Button" parent="Panel/VBox"]
text = "Start Game"

[node name="LoadButton" type="Button" parent="Panel/VBox"]
text = "Load Game"

[node name="SimSeparator" type="HSeparator" parent="Panel/VBox"]

[node name="SingleValleySimButton" type="Button" parent="Panel/VBox"]
text = "Single Valley Simulation"

[node name="HouseholdEconomySimButton" type="Button" parent="Panel/VBox"]
text = "Household Economy Simulation"

[node name="LargeValleysSimButton" type="Button" parent="Panel/VBox"]
text = "Large Valleys Simulation"

[node name="RiverValleyViewButton" type="Button" parent="Panel/VBox"]
text = "Single Valley (Game View)"

[node name="HintLabel" type="Label" parent="Panel/VBox"]
text = "Hold Alt + move mouse to tilt camera"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 11
modulate = Color(0.65, 0.65, 0.75, 1)

[connection signal="pressed" from="Panel/VBox/StartButton" to="." method="_on_start_pressed"]
[connection signal="pressed" from="Panel/VBox/LoadButton" to="." method="_on_load_pressed"]
[connection signal="pressed" from="Panel/VBox/SingleValleySimButton" to="." method="_on_single_valley_sim_pressed"]
[connection signal="pressed" from="Panel/VBox/HouseholdEconomySimButton" to="." method="_on_household_economy_sim_pressed"]
[connection signal="pressed" from="Panel/VBox/LargeValleysSimButton" to="." method="_on_large_valleys_sim_pressed"]
[connection signal="pressed" from="Panel/VBox/RiverValleyViewButton" to="." method="_on_river_valley_view_pressed"]
